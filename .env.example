APP_NAME=CafeVerse
APP_ENV=local
APP_KEY=
# Set APP_DEBUG=false whenever the app is shown to others: with true,
# errors reveal file paths and code to anyone using the API.
APP_DEBUG=true
# Use your computer's Wi-Fi IP when testing on a real phone,
# e.g. http://192.168.1.5:8000, so image URLs work on the device.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cafeverse
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Login tokens -----------------------------------------------------
# How long a login stays valid, in minutes (43200 = 30 days).
SANCTUM_EXPIRATION_MINUTES=43200

# --- Admin account (created by: php artisan db:seed) --------------------
ADMIN_NAME="CaféVerse Admin"
ADMIN_EMAIL=admin@cafeverse.test
ADMIN_PASSWORD=

# --- Café Yatra rules ----------------------------------------------------
# For a live demo you can set MIN_VISIT_MINUTES=0 and ONE_VISIT_PER_DAY=false.
CAFEVERSE_CHECK_IN_RADIUS=100
CAFEVERSE_MIN_VISIT_MINUTES=5
CAFEVERSE_MAX_VISIT_HOURS=12
CAFEVERSE_ONE_VISIT_PER_DAY=true
CAFEVERSE_TIMEZONE=Asia/Kathmandu
